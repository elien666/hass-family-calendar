{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Home Assistant",
			"type": "shell",
			"command": "supervisor_run",
			"group": {
			  "kind": "test",
			  "isDefault": true
			},
			"presentation": {
			  "reveal": "always",
			  "panel": "new"
			},
			"problemMatcher": []
		  },
		{
			"label": "build",
			"type": "shell",
			"command": "pnpm run build",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"label": "deploy",
			"type": "shell",
			"command": "${workspaceFolder}/scripts/dev-deploy.sh",
			"args": ["--skip-build"],
			"group": "none",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"options": {
				"env": {
					"HA_ADDON_DIR": "${env:HA_ADDON_DIR}"
				}
			}
		},
		{
			"label": "build-and-deploy",
			"type": "shell",
			"command": "${workspaceFolder}/scripts/dev-deploy.sh",
			"group": "none",
			"dependsOn": [],
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"options": {
				"env": {
					"HA_ADDON_DIR": "${env:HA_ADDON_DIR}"
				}
			}
		},
		{
			"label": "watch-and-deploy",
			"type": "shell",
			"command": "${workspaceFolder}/scripts/dev-deploy.sh",
			"args": ["--watch"],
			"group": "none",
			"isBackground": true,
			"problemMatcher": {
				"owner": "custom",
				"pattern": {
					"regexp": ".",
					"file": 1,
					"location": 2,
					"message": 3
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "Starting watch mode",
					"endsPattern": "Watching:"
				}
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true
			},
			"options": {
				"env": {
					"HA_ADDON_DIR": "${env:HA_ADDON_DIR}",
					"HA_HOST": "${env:HA_HOST}",
					"HA_TOKEN": "${env:HA_TOKEN}"
				}
			}
		},
		{
			"label": "deploy-and-restart",
			"type": "shell",
			"command": "${workspaceFolder}/scripts/dev-deploy.sh",
			"args": [
				"--restart"
			],
			"group": "none",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"options": {
				"env": {
					"HA_HOST": "${env:HA_HOST}",
					"HA_TOKEN": "${env:HA_TOKEN}",
					"HA_ADDON_DIR": "${env:HA_ADDON_DIR}"
				}
			}
		},
		{
			"type": "shell",
			"label": "docker-build",
			"command": "docker",
			"args": [
				"build",
				"--pull",
				"-f",
				"${workspaceFolder}/add-on/Dockerfile",
				"-t",
				"hass-family-calendar:latest",
				"${workspaceFolder}/add-on/"
			],
			"group": "none",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"type": "shell",
			"label": "docker-run: release",
			"command": "docker",
			"args": [
				"run",
				"--rm",
				"-p",
				"8080:80",
				"hass-family-calendar:latest"
			],
			"dependsOn": [
				"docker-build"
			],
			"group": "none",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"type": "shell",
			"label": "docker-run: debug",
			"command": "docker",
			"args": [
				"run",
				"--rm",
				"-p",
				"8080:80",
				"-e",
				"DEBUG=*",
				"-e",
				"NODE_ENV=development",
				"hass-family-calendar:latest"
			],
			"dependsOn": [
				"docker-build"
			],
			"group": "none",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		}
	]
}