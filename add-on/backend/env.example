# Home Assistant Configuration
# For local development, set these to connect to your Home Assistant instance
HASS_HOST=http://homeassistant.local:8123
HASS_ACCESS_TOKEN=your-long-lived-access-token-here

# Optional: WebSocket URL (auto-derived from HASS_HOST if not set)
# HASS_WEBSOCKET_URL=ws://homeassistant.local:8123/api/websocket

# Optional: Supervisor Token (only needed if running in HA add-on mode)
# SUPERVISOR_TOKEN=your-supervisor-token

# ============================================================================
# Feature Configuration
# Set these to enable and configure features
# ============================================================================

# Weather Forecast (Pirate Weather API)
# WEATHER_ENABLED=true
# WEATHER_API_KEY=your-pirate-weather-api-key
# WEATHER_LATITUDE=53.570
# WEATHER_LONGITUDE=10.091

# HVV Public Transport (Geofox API)
# HVV_ENABLED=true
# GEOFOX_USER=your-geofox-username
# GEOFOX_SECRET=your-geofox-secret

# Garage Door
# GARAGE_ENABLED=true
# ENTITY_GARAGE_DOOR=cover.garage_door

# Laundry Machines (JSON array)
# LAUNDRY_ENABLED=true
# LAUNDRY_MACHINES=[{"name":"Washer","entity_id":"sensor.washing_machine"},{"name":"Dryer","entity_id":"sensor.dryer"}]

# Doorbell
# DOORBELL_ENABLED=true
# ENTITY_DOORBELL=binary_sensor.doorbell
# ENTITY_DOORBELL_BUTTON=button.doorbell_unlatch
# DOORBELL_CAMERAS=[{"entity_id":"camera.doorbell_front","orientation":"landscape"}]

# Everyday Calendar
# EVERYDAY_CALENDAR_ENABLED=true
# ENTITY_EVERYDAY_CALENDAR=sensor.everyday_calendar

# EV (Electric Vehicle)
# EV_ENABLED=true
# ENTITY_PRECLIMATE_STATUS=binary_sensor.ev_preclimate
# ENTITY_PRECLIMATE_START=button.ev_preclimate_start
# ENTITY_PRECLIMATE_STOP=button.ev_preclimate_stop
# ENTITY_CHARGING_STATE=binary_sensor.ev_charging
# ENTITY_STATE_OF_CHARGE=sensor.ev_battery

# Calendars (JSON array)
# CALENDARS=[{"name":"Family Calendar","icon":"mdi:calendar"},{"name":"Work","icon":"mdi:briefcase"}]

# Frigate (for camera feeds)
# FRIGATE_HOST=http://frigate.local:5000
# FRIGATE_USER=your-frigate-username
# FRIGATE_PASSWORD=your-frigate-password

# Note: In production (Home Assistant add-on), these are automatically configured
# via the add-on's configuration UI, not environment variables.
# 
# Legacy VITE_ prefixed variables are also supported for backward compatibility.
