#!/command/with-contenv bashio
# ==============================================================================
# Start the Family Calendar backend
# ==============================================================================
bashio::log.info "Starting Family Calendar backend..."
cd /app || bashio::exit.nok "Could not change to /app directory"
export PYTHONPATH="/app"
exec python3 -m uvicorn backend.main:app --host 0.0.0.0 --port 80
