# Home Assistant Configuration (Required for Local Development)
VITE_HASS_HOST=https://your-instance.ui.nabu.casa
VITE_HASS_ACCESS_TOKEN=your_long_lived_access_token

# Weather API Configuration (Optional - disables weather feature if not set)
VITE_WEATHER_API_KEY=your_pirate_weather_api_key
VITE_WEATHER_LATITUDE=53.570
VITE_WEATHER_LONGITUDE=10.091

# Geofox API Configuration (Optional - disables HVV departures if not set)
VITE_GEOFOX_SECRET=your_geofox_secret
VITE_GEOFOX_USER=your_geofox_user

# Entity IDs (Optional - disables respective features if not set)
VITE_ENTITY_GARAGE_DOOR=binary_sensor.garage_door
VITE_ENTITY_DOORBELL=binary_sensor.doorbell
VITE_ENTITY_DOORBELL_BUTTON=button.doorbell_unlatch
VITE_ENTITY_DOORBELL_PERSON_OCCUPANCY=binary_sensor.doorbell_person_occupancy
VITE_ENTITY_EVERYDAY_CALENDAR=sensor.everyday_calendar

# Laundry Machines Configuration (Optional - JSON array)
# Example: [{"name":"New Washer","entity_id":"sensor.washing_machine_new"},{"name":"Dryer","entity_id":"sensor.dryer"}]
VITE_LAUNDRY_MACHINES=[]

# Go2RTC Base URL (Optional)
VITE_GO2RTC_BASE_URL=http://192.168.188.10:1984

# Calendars Configuration (Optional - JSON array)
# Example: [{"name":"Personal","icon":"mdi:calendar"},{"name":"Work","icon":"mdi:briefcase"}]
VITE_CALENDARS=[]

# Doorbell Cameras Configuration (Optional - JSON array)
# Example: [{"name":"front_door","orientation":"landscape"},{"name":"back_door","orientation":"portrait"}]
VITE_DOORBELL_CAMERAS=[]
