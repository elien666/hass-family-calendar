# Home Assistant Configuration
# For local development, set these to connect to your Home Assistant instance
VITE_HASS_HOST=http://homeassistant.local:8123
VITE_HASS_ACCESS_TOKEN=your-long-lived-access-token-here

# Optional: Supervisor Token (only needed if running in HA add-on mode)
# VITE_SUPERVISOR_TOKEN=your-supervisor-token

# Optional: Ingress URL (only needed if running in HA add-on mode)
# VITE_INGRESS_URL=/api/hassio_ingress/xxxxx/

# ============================================================================
# Feature Configuration
# Set these to enable and configure features
# ============================================================================

# Weather Forecast (Pirate Weather API)
# VITE_ENABLE_WEATHER=true
# VITE_WEATHER_API_KEY=your-pirate-weather-api-key
# VITE_WEATHER_LATITUDE=53.570
# VITE_WEATHER_LONGITUDE=10.091

# HVV Public Transport (Geofox API)
# VITE_ENABLE_HVV=true
# VITE_GEOFOX_USER=your-geofox-username
# VITE_GEOFOX_SECRET=your-geofox-secret

# Garage Door
# VITE_ENABLE_GARAGE=true
# VITE_ENTITY_GARAGE_DOOR=cover.garage_door

# Laundry Machines (JSON array)
# VITE_ENABLE_LAUNDRY=true
# VITE_LAUNDRY_MACHINES=[{"name":"Washer","entity_id":"sensor.washing_machine"},{"name":"Dryer","entity_id":"sensor.dryer"}]

# Doorbell
# VITE_ENABLE_DOORBELL=true
# VITE_ENTITY_DOORBELL=binary_sensor.doorbell
# VITE_ENTITY_DOORBELL_BUTTON=button.doorbell_unlatch
# VITE_DOORBELL_CAMERAS=[{"entity_id":"camera.doorbell_front","orientation":"landscape"}]

# Everyday Calendar
# VITE_ENABLE_EVERYDAY_CALENDAR=true
# VITE_ENTITY_EVERYDAY_CALENDAR=sensor.everyday_calendar

# EV (Electric Vehicle)
# VITE_ENABLE_EV=true
# VITE_ENTITY_PRECLIMATE_STATUS=binary_sensor.ev_preclimate
# VITE_ENTITY_PRECLIMATE_START=button.ev_preclimate_start
# VITE_ENTITY_PRECLIMATE_STOP=button.ev_preclimate_stop
# VITE_ENTITY_CHARGING_STATE=binary_sensor.ev_charging
# VITE_ENTITY_STATE_OF_CHARGE=sensor.ev_battery

# Calendars (JSON array)
# VITE_CALENDARS=[{"name":"Family Calendar","icon":"mdiCake"},{"name":"Work","icon":"mdiBriefcase"}]

# Frontend Logging (enable logging to backend API)
# VITE_ENABLE_LOGGING=true

# Note: In production (Home Assistant add-on), these are automatically configured
# via the add-on's configuration UI, not environment variables.
# 
# All Vite environment variables must be prefixed with VITE_ to be accessible in the frontend.
