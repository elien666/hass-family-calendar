# Environment Variables for Local Development
# 
# NOTE: Vite automatically sets import.meta.env.DEV based on build mode:
#   - pnpm start (dev server) → import.meta.env.DEV = true (uses these env vars)
#   - pnpm run build (production) → import.meta.env.DEV = false (ignores these, uses relative URLs)
#
# For production builds (add-on deployment), these vars are NOT used to prevent token leakage.
# The add-on uses ingress authentication and relative URLs instead.

# Home Assistant Configuration
# Required for local development: Your Home Assistant instance URL
VITE_HASS_HOST=http://localhost:7123
# Required for local development: Long-lived access token from Home Assistant
VITE_HASS_ACCESS_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiI3Zjg4NGYyZmM0OTU0ZGU5OGE3MDlmNzMwYWJkMzg1MCIsImlhdCI6MTc2Mzk3MDc3NiwiZXhwIjoyMDc5MzMwNzc2fQ.VlPVhfHUdRmLAzptk_3-E9eT7ygrSv-9qKeFZ-z_j1o

# Weather API (Pirate Weather)
# Required: Get your API key from https://pirateweather.net
VITE_WEATHER_API_KEY=t34finKGz44m6qxPyUqfi2UnecLEa5QM3e9puJN3
# Optional: Default coordinates (Hamburg, Germany)
VITE_WEATHER_LATITUDE=53.570
VITE_WEATHER_LONGITUDE=10.091

# Geofox API (HVV - Hamburg Public Transport)
# Required: Get credentials from Geofox
VITE_GEOFOX_SECRET=vKD)Lt6AtCKb
VITE_GEOFOX_USER=BjoernGaworski-Dammann

# Telegram Bot (Optional - for debugging)
# Leave empty if not using Telegram notifications
VITE_TELEGRAM_BOT_TOKEN=370225026:AAGM5FD1JpvMnd1ShDkf9sx5Vr4g9rAF69Q
VITE_TELEGRAM_CHAT_ID=195619890

# Physical Buttons WebSocket (Optional)
# WebSocket URL for physical button integration
VITE_BUTTONS_WS_URL=ws://192.168.188.35:5678/

# Feature Enable Flags (optional)
# If not set, features auto-enable in dev mode if their config is present
# Set to "true" or "false" for explicit control
VITE_ENABLE_WEATHER=true
VITE_ENABLE_HVV=true
VITE_ENABLE_TELEGRAM=true
VITE_ENABLE_GARAGE=true
VITE_ENABLE_LAUNDRY=true
VITE_ENABLE_DOORBELL=true
VITE_ENABLE_EVERYDAY_CALENDAR=true

# Home Assistant Entity IDs
# Update these to match your Home Assistant entity names
VITE_ENTITY_GARAGE_DOOR=cover.garagentor
VITE_ENTITY_DOORBELL=binary_sensor.tuerklingel_person
VITE_ENTITY_DOORBELL_BUTTON=button.haustur_unlatch_2
VITE_ENTITY_EVERYDAY_CALENDAR=sensor.everyday_calendar

# Laundry Machines Configuration (optional)
# JSON array of machines with name and entity_id
# Example: [{"name":"New Washer","entity_id":"sensor.washing_machine_new"},{"name":"Dryer","entity_id":"sensor.dryer"}]
VITE_LAUNDRY_MACHINES=[{"name":"New Washer","entity_id":"input_select.wasching_machine_neu_status"},{"name":"Old Washer","entity_id":"input_select.washing_machine_alt_status"},{"name":"Dryer","entity_id":"input_select.dryer_status"}]

# Calendars Configuration (optional)
# JSON array of calendars with name and optional icon
# Example: [{"name":"Family Calendar","icon":"mdi:calendar"},{"name":"Work Calendar","icon":"mdi:briefcase"}]
VITE_CALENDARS=[{"name":"calendar.test"}]