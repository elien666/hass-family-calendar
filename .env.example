# Home Assistant Configuration
# Required: Your Home Assistant instance URL
VITE_HASS_HOST=https://your-instance.ui.nabu.casa
# Required: Long-lived access token from Home Assistant
VITE_HASS_ACCESS_TOKEN=your_hass_access_token_here

# Weather API (Pirate Weather)
# Required: Get your API key from https://pirateweather.net
VITE_WEATHER_API_KEY=your_weather_api_key_here
# Optional: Default coordinates (Hamburg, Germany)
VITE_WEATHER_LATITUDE=53.570
VITE_WEATHER_LONGITUDE=10.091

# Geofox API (HVV - Hamburg Public Transport)
# Required: Get credentials from Geofox
VITE_GEOFOX_SECRET=your_geofox_secret_here
VITE_GEOFOX_USER=your_geofox_username

# Telegram Bot (Optional - for debugging)
# Leave empty if not using Telegram notifications
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=

# Physical Buttons WebSocket (Optional)
# WebSocket URL for physical button integration
VITE_BUTTONS_WS_URL=ws://:5678/

# Home Assistant Entity IDs
# Update these to match your Home Assistant entity names
VITE_ENTITY_GARAGE_DOOR=cover.garagentor
VITE_ENTITY_WASHING_MACHINE_NEW=input_select.wasching_machine_neu_status
VITE_ENTITY_WASHING_MACHINE_OLD=input_select.washing_machine_alt_status
VITE_ENTITY_DRYER=input_select.dryer_status
VITE_ENTITY_DOORBELL=binary_sensor.tuerklingel_person
VITE_ENTITY_DOORBELL_BUTTON=button.haustur_unlatch_2
VITE_ENTITY_EVERYDAY_CALENDAR=sensor.everyday_calendar
